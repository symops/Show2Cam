// Resources of Show2Cam.sys: version information (file properties, Device Manager "Driver" tab).
#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     S2C_VER_MAJOR,S2C_VER_MINOR,S2C_VER_BUILD,S2C_VER_REV
PRODUCTVERSION  S2C_VER_MAJOR,S2C_VER_MINOR,S2C_VER_BUILD,S2C_VER_REV
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DRV
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      S2C_AUTHOR
            VALUE "LegalCopyright",   S2C_COPYRIGHT
            VALUE "FileDescription",  "Show2Cam virtual cameras"
            VALUE "FileVersion",      S2C_VER_STR
            VALUE "InternalName",     "Show2Cam.sys"
            VALUE "OriginalFilename", "Show2Cam.sys"
            VALUE "ProductName",      "Show2Cam"
            VALUE "ProductVersion",   S2C_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
